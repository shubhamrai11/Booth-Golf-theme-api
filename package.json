{
  "name": "fairway-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Temporary golf photo booth: capture, generate, print and clear",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-server.mjs",
    "build:web": "vite build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.28.2",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
