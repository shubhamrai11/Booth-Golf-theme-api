{
  "name": "fairway-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Windows golf photo booth with Canon capture, AI portraits and individual QR downloads",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-server.mjs",
    "build:web": "vite build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/functions": "^3.9.11",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.28.2",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
