{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "functions": { "api/index.js": { "maxDuration": 300 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?route=/api/:path*" },
    { "source": "/p/:token", "destination": "/api?route=/p/:token" },
    { "source": "/photo/:token", "destination": "/api?route=/photo/:token" },
    { "source": "/download/:token", "destination": "/api?route=/download/:token" },
    { "source": "/kiosk", "destination": "/index.html" },
    { "source": "/display", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" }
  ] }]
}
